# 根目錄 .env.example — 複製為 .env 後依需求調整
# 供 docker-compose / Claude Code .mcp.json 的 ${VAR} 插值使用

# ─── PostgreSQL ───
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban_secret
POSTGRES_DB=kanban
DATABASE_URL="postgresql://kanban:kanban_secret@localhost:5444/kanban"

# ─── Keycloak（admin 帳號 / 預設 SSO 使用者由 realm-export.json 提供）───
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── NextAuth ───
AUTH_SECRET=your-auth-secret-change-me-at-least-32-chars

# ─── Keycloak Client（admin app 用）───
AUTH_KEYCLOAK_ID=kanban-admin
AUTH_KEYCLOAK_SECRET=kanban-admin-secret
# 容器化部署（docker compose）使用 host.docker.internal，確保 admin 容器與瀏覽器走同一 URL
# 本機 npm run dev 開發時，請改為 http://localhost:8080/realms/kanban
AUTH_KEYCLOAK_ISSUER=http://host.docker.internal:8080/realms/kanban

# ─── 登入流程設定 ───
# 帳密登入：admin 啟用 CredentialsProvider；Demo 預設 true
AUTH_ALLOW_CREDENTIALS=true
# Keycloak SSO 按鈕：登入頁是否顯示「以 Keycloak 登入」按鈕；預設不顯示，避免導向 Keycloak
NEXT_PUBLIC_AUTH_KEYCLOAK_ENABLED=false

# ─── Seed 控制 ───
# 預設 true：admin 啟動時自動跑 prisma seed（upsert，安全可重複執行）
# 想跳過（例如已手動修改過預設使用者）設為 false
SEED_ON_START=true

# ─── Studio 影片工作室（worker + interview LLM）───
# Redis（compose 內 worker/admin 已寫死 redis://redis:6379；此值供本機 npm run dev/worker 用）
REDIS_URL=redis://localhost:6379
# 影片儲存根（compose 內為 /studio-storage volume；本機可設絕對路徑）
STUDIO_STORAGE_ROOT=
# Seal-TTS（內網）
SEAL_TTS_URL=http://192.168.50.57:7866
SEAL_TTS_API_KEY=
# 訪談 / 新增分鏡協助 LLM provider：anthropic（預設）或 vertex（Gemini on Vertex AI）
LLM_PROVIDER=anthropic
# Anthropic（LLM_PROVIDER=anthropic 時用）
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
# Gemini on Vertex AI（LLM_PROVIDER=vertex 時用）。憑證請用「新的」service account（舊 _gcp_sa.json 已外洩需 rotate）。
# GOOGLE_VERTEX_CREDENTIALS 放整串 SA JSON（單行）：在 WSL/Git Bash 用  jq -c . sa.json  壓成一行貼上。
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
GOOGLE_VERTEX_MODEL=gemini-flash-latest
GOOGLE_VERTEX_CREDENTIALS=
# SDXL 關鍵幀 checkpoint
STUDIO_SDXL_CKPT=juggernautXL_v9_V9 + RDPhoto 2.safetensors
# Docker：worker 連回主機 ComfyUI（ComfyUI 須以 --listen 0.0.0.0 啟動）
COMFYUI_URL=http://host.docker.internal:8188
# Docker：主機 ComfyUI 目錄，掛進 worker 的 /comfyui（Docker Desktop 須開 D: 磁碟分享）
COMFYUI_DIR_HOST=D:/BaiduNetdiskDownload/260518-WY-S130-ComfyUI/260518-WY-S130-ComfyUI/ComfyUI

# ─── 媒體庫（MinIO / S3 相容物件儲存，私密 + presigned URL）───
# 私密模式：bucket 不開匿名讀，前端一律用後端即時簽的限時 URL。
# endpoint 與 public URL 都要用「瀏覽器/容器皆可達」的對外位址（presigned 才簽得對）。
# 叢集內部署可把 S3_ENDPOINT 改成內部 svc，但 S3_PUBLIC_URL 仍須是對外位址。
S3_ENDPOINT=https://minio.markkulab.net
S3_PUBLIC_URL=https://minio.markkulab.net
S3_REGION=us-east-1
S3_BUCKET=studio-media
# 建議用 studio-media 專屬 user（policy 只綁此 bucket），勿用 minioadmin
S3_ACCESS_KEY=
S3_SECRET_KEY=
